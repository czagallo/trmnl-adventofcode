PORT=3012
BASE_URL=https://your-public-plugin-url.example
TRMNL_CLIENT_ID=your_client_id_here
TRMNL_CLIENT_SECRET=your_client_secret_here

# Optional: identify this server to Advent of Code (AoC asks automated tools to include a way to reach the operator)
# AOC_USER_AGENT=trmnl-adventofcode/1.0 (+https://github.com/czagallo/trmnl-adventofcode)

# Local testing only (curl /markup without a user uuid, npm run preview -- --live). Never used for real TRMNL users.
# AOC_SESSION=
# AOC_LEADERBOARD_ID=
# AOC_YEAR=auto
# AOC_MEMBER_ID=
