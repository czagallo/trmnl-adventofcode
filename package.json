{
  "name": "trmnl-adventofcode",
  "version": "1.0.0",
  "description": "TRMNL plugin that shows an Advent of Code private leaderboard, today's puzzle and the countdown to the next unlock",
  "main": "server.js",
  "private": true,
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test",
    "preview": "node scripts/preview.js"
  },
  "keywords": ["trmnl", "plugin", "advent-of-code", "leaderboard"],
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.21.2"
  }
}
